APP_NAME="WGH Intelligence"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.websitesgh.com/dashboard

LOG_CHANNEL=stack
LOG_LEVEL=info

# Postgres is the target. If the shared plan turns out to have no Postgres,
# change this one line to mysql and set the port to 3306. Nothing else moves.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wgh_intelligence
DB_USERNAME=wgh
DB_PASSWORD=

CACHE_STORE=file

# The shop connector.
# WGH_SHOP_SECRET is the value shown at Tools > WGH Dashboard Access on the
# shop, or the WGHS_DASHBOARD_SECRET constant in the shop's wp-config.php.
WGH_SHOP_URL=https://shop.websitesgh.com
WGH_SHOP_SECRET=
WGH_SYNC_PAGE_SIZE=200
WGH_SYNC_MAX_PAGES=200
WGH_SYNC_TIMEOUT=30
WGH_SYNC_RETRIES=3
WGH_SYNC_OVERLAP=120
