/vendor
/node_modules
.env
.env.backup
.phpunit.result.cache
composer.lock

# Keep the directories, drop their contents. Without the !.gitkeep lines a
# fresh clone has no storage/framework/views and Laravel fails on first boot.
/storage/app/*
!/storage/app/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Generated briefing packs are data, not code.
/storage/app/briefings/*
!/storage/app/briefings/.gitkeep
