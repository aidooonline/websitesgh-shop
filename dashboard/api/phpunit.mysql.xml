<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite, against MySQL/MariaDB.

    WHY THIS FILE EXISTS
    The default suite runs on SQLite because it is instant and needs no server.
    SQLite is also far more forgiving than the production database: it accepts
    `COUNT(*) FILTER (WHERE ...)`, which is Postgres and SQLite syntax that
    MariaDB rejects outright. The whole suite went green on a query the live
    server refused to run, and the owner found it instead of the tests.

    The live server is MariaDB 11.4. Anything touching selectRaw, whereRaw,
    orderByRaw or DB::statement must be run through this file before it ships.

    Set up once:
      CREATE DATABASE wgh_test CHARACTER SET utf8mb4;
      CREATE USER 'wgh'@'127.0.0.1' IDENTIFIED BY 'wgh';
      GRANT ALL ON wgh_test.* TO 'wgh'@'127.0.0.1';

    Then:
      php artisan test -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="wgh_test"/>
        <env name="DB_USERNAME" value="wgh"/>
        <env name="DB_PASSWORD" value="wgh"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="WGH_SHOP_SECRET" value="test-secret-not-a-real-one"/>
    </php>
</phpunit>
